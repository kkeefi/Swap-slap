func get_maps(mode: int) -> Array:
	match mode:
		Globals.Mode.BATTLE_RING: return BATTLE
		Globals.Mode.CRUMBLING:   return CRUMBLE
		Globals.Mode.LAVA:        return LAVA
		Globals.Mode.KING:        return KING
		Globals.Mode.CHAOS:       return CHAOS
	return BATTLE

func pick_random(mode: int) -> Dictionary:
	var pool = get_maps(mode)
	var m = pool[randi() % pool.size()].duplicate(true)
	return m
